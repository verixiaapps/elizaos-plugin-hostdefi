# EVM private key (hex, 0x-prefixed) of the wallet that pays for x402 calls.
# Fund it with a small amount of USDC on Base (and/or Polygon/Arbitrum/Avalanche)
# — each call costs the route's listed price, typically $0.002–$0.05.
HOSTDEFI_EVM_PRIVATE_KEY=0x...

# Optional: max per-call spend the agent is allowed to authorize, in USDC
# (6 decimals). Defaults to 0.25. Payments above this are refused before signing.
HOSTDEFI_X402_MAX_USDC=0.25

# Optional: override the API base. Defaults to https://hostdefi.com/api
HOSTDEFI_X402_BASE_URL=https://hostdefi.com/api
